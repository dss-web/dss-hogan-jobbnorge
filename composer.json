{
	"name": "dss-web/dss-hogan-jobbnorge",
	"description": "DSS Download Module for Hogan",
	"homepage": "https://github.com/dss-web/dss-hogan-jobbnorge",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=7.0",
		"composer/installers": "~1.2",
		"dekodeinteraktiv/hogan-core": ">=1.4.2"
	},
	"authors": [
		{
			"name": "Per Søderlind",
			"email": "per@soderlind.no",
			"homepage": "http://soderlind.no"
		}
	],
	"archive": {
		"exclude": [
			".editorconfig",
			".gitignore",
			".stylelintrc",
			"CHANGELOG.md",
			"composer.json",
			"composer.lock",
			"LICENSE",
			"package.json",
			"phpcs.xml",
			"phpunit.xml.dist",
			"tests",
			"vendor",
			"yarn.lock"
		]
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"phpunit/phpunit": "^9.6"
	},
	"autoload-dev": {
		"psr-4": {
			"DSS\\Hogan\\Jobbnorge\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	}
}
